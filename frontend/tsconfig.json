{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "paths": {
      "@/components/*": ["./components/*", "./app/components/*"],
      "@/hooks/*": ["./app/hooks/*"],
      "@/*": ["./*"],
      // Workaround: onnxruntime-web@1.x puts "types" at the package root but
      // omits it from its "exports" map, so moduleResolution "bundler" cannot
      // find it automatically. Redirect TS directly to the known types file.
      "onnxruntime-web": ["../node_modules/onnxruntime-web/types.d.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
